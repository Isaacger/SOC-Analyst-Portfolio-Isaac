{
  "visualizations": {
    "viz_1mNAP3eC": {
      "type": "splunk.column",
      "dataSources": {
        "primary": "ds_TssU3jCj"
      },
      "title": "Failed logons over time"
    },
    "viz_IRRLiT2l": {
      "type": "splunk.bar",
      "title": "Failed logons by account",
      "dataSources": {
        "primary": "ds_kzdWVCQ3"
      }
    },
    "viz_0yFqEqOc": {
      "type": "splunk.bar",
      "dataSources": {
        "primary": "ds_ETSEyPSJ"
      },
      "title": "Failed logons by status"
    }
  },
  "dataSources": {
    "ds_TssU3jCj": {
      "type": "ds.search",
      "options": {
        "query": "index=main sourcetype=\"WinEventLog:Security\" EventCode=4625 | timechart span=1h count"
      },
      "name": "Search_1"
    },
    "ds_kzdWVCQ3": {
      "type": "ds.search",
      "options": {
        "query": "index=main sourcetype=\"WinEventLog:Security\" EventCode=4625\n| eval failed_account=mvindex(Nombre_de_cuenta,-1)\n| stats count BY failed_account\n| sort - count"
      },
      "name": "Search_2"
    },
    "ds_ETSEyPSJ": {
      "type": "ds.search",
      "options": {
        "query": "index=main sourcetype=\"WinEventLog:Security\" EventCode=4625\n| stats count BY Subestado\n| sort - count"
      },
      "name": "Search_3"
    }
  },
  "defaults": {
    "dataSources": {
      "ds.search": {
        "options": {
          "queryParameters": {
            "latest": "$global_time.latest$",
            "earliest": "$global_time.earliest$"
          }
        }
      },
      "ds.spl2": {
        "options": {
          "queryParameters": {
            "latest": "$global_time.latest$",
            "earliest": "$global_time.earliest$"
          }
        }
      }
    },
    "visualizations": {
      "global": {
        "showProgressBar": true
      }
    }
  },
  "inputs": {
    "input_global_trp": {
      "type": "input.timerange",
      "options": {
        "token": "global_time",
        "defaultValue": "-30d@d,now"
      },
      "title": "Global Time Range"
    }
  },
